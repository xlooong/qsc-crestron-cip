--==============================================================================
-- TriggerToMomentary
-- Converts trigger button inputs to momentary (pulsed) outputs.
-- Each trigger fires its corresponding output true for a configurable duration.
-- Retriggerable: re-firing while active resets the timer.
--==============================================================================

PluginInfo = {
  Name = "wxl_personal_plug~TriggerToMomentary",
  Version = "1.0.0",
  Author = "longwang",
  Id = "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  Description = "Convert trigger inputs to momentary pulsed outputs with configurable duration"
}

Palette = {
  Blue    = {46, 63, 87},
  White   = {255, 255, 255},
  Black   = {0, 0, 0},
  Red     = {220, 60, 60},
  Green   = {60, 180, 60},
  Orange  = {230, 140, 30},
  Gray    = {160, 160, 160},
}

local SIGNALS_PER_PAGE = 50

function BuildPageList(props)
  local pages = {{ name = "Config", ptype = "config" }}
  local count = math.floor(props["trigger_count"].Value)
  local numPages = math.ceil(count / SIGNALS_PER_PAGE)
  for p = 1, numPages do
    local startIdx = (p - 1) * SIGNALS_PER_PAGE + 1
    local endIdx = math.min(p * SIGNALS_PER_PAGE, count)
    table.insert(pages, {
      name = string.format("Signals %d-%d", startIdx, endIdx),
      ptype = "signals",
      startIdx = startIdx,
      endIdx = endIdx
    })
  end
  return pages
end

function GetPages(props)
  local pages = BuildPageList(props)
  local result = {}
  for _, p in ipairs(pages) do
    table.insert(result, { name = p.name })
  end
  return result
end

function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "trigger_count",
    Type = "double",
    Min = 0,
    Max = 500,
    Value = 32
  })
  table.insert(props, {
    Name = "momentary_duration",
    Type = "double",
    Min = 0.1,
    Max = 10.0,
    Value = 0.5
  })
  return props
end

function RectifyProperties(props)
  return props
end

function GetComponents(props)
  return {}
end

function GetPins(props)
  return {}
end

function GetColor(props)
  return Palette.Blue
end

function GetPrettyName(props)
  return "TriggerToMomentary"
end

function GetControls(props)
  local ctrls = {}
  local count = math.floor(props["trigger_count"].Value)

  -- Duration override on panel
  table.insert(ctrls, {
    Name = "Duration_Input",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 1,
    Max = 100,
    DefaultValue = math.floor(props["momentary_duration"].Value * 10),
    PinStyle = "Input",
    UserPin = false,
    Count = 1
  })

  -- Active count display
  table.insert(ctrls, {
    Name = "Active_Count",
    ControlType = "Text",
    DefaultValue = "0",
    UserPin = false,
    Count = 1
  })

  -- Trigger inputs (Trigger type for trigger pins, rising edge fires)
  for i = 1, count do
    table.insert(ctrls, {
      Name = "Trigger_In_" .. i,
      ControlType = "Button",
      ButtonType = "Trigger",
      DefaultValue = false,
      PinStyle = "Input",
      UserPin = true,
      Count = 1
    })
  end

  -- Momentary outputs
  for i = 1, count do
    table.insert(ctrls, {
      Name = "Momentary_Out_" .. i,
      ControlType = "Button",
      ButtonType = "Toggle",
      DefaultValue = false,
      PinStyle = "Output",
      UserPin = true,
      Count = 1
    })
  end

  return ctrls
end

